            "title": "Web tension — unwind vs rewind",
            "unit": "",
            "keys": [
              "tenU",
              "tenR"
            ],
            "names": [
              "Unwind",
              "Rewind"
            ],
            "colors": [
              "a",
              "b"
            ],
            "min": "",
            "max": "",
            "step": false,
            "limit": null,
            "axisLabel": "",
            "window": 15
          }
        },
