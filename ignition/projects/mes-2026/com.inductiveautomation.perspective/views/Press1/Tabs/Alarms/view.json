                    "type": "ia.display.label",
                    "meta": {
                      "name": "Th_7"
                    },
                    "props": {
                      "text": "Detail",
                      "style": {
                        "classes": "th"
                      }
                    },
                    "position": {
                      "grow": 2.6,
                      "shrink": 1,
                      "basis": "0"
                    }
                  },
                  {
                    "type": "ia.display.label",
                    "meta": {
                      "name": "Th_8"
                    },
                    "props": {
                      "text": "Job",
                      "style": {
                        "classes": "th"
                      }
                    },
                    "position": {
