      {
        "type": "ia.display.view",
        "meta": {
          "name": "StateTrend"
        },
        "props": {
          "path": "Press1/Parts/Trend",
          "params": {
            "title": "Machine state  (1 Running · 2 Setup · 3 Faulted)",
            "unit": "",
            "keys": [
              "state"
            ],
            "names": [
              "State"
            ],
            "colors": [
              "a"
            ],
            "min": 0.5,
            "max": 3.5,
            "step": true,
            "limit": null,
            "axisLabel": "",
            "window": 15
          }
        },
        "position": {
          "shrink": 0,
          "basis": "210px"
        },
        "propConfig": {
          "props.params.window": {
            "binding": {
              "type": "property",
              "config": {
                "path": "view.params.window"
              }
            }
          }
        }
      },
