                    "props": {
                      "text": "Code",
                      "style": {
                        "classes": "th"
                      }
                    },
                    "position": {
                      "grow": 1,
                      "shrink": 1,
                      "basis": "0"
                    }
                  },
                  {
                    "type": "ia.display.label",
                    "meta": {
                      "name": "Th_2"
                    },
                    "props": {
                      "text": "Alarm",
                      "style": {
                        "classes": "th"
                      }
                    },
                    "position": {
                      "grow": 2.5,
                      "shrink": 1,
                      "basis": "0"
                    }
                  },
                  {
                    "type": "ia.display.label",
                    "meta": {
                      "name": "Th_3"
                    },
                    "props": {
                      "text": "Count",
                      "style": {
                        "classes": "th"
                      }
                    },
                    "position": {
                      "grow": 1,
                      "shrink": 1,
                      "basis": "0"
                    }
                  },
                  {
                    "type": "ia.display.label",
                    "meta": {
                      "name": "Th_4"
                    },
                    "props": {
                      "text": "Total time",
                      "style": {
                        "classes": "th"
                      }
                    },
                    "position": {
                      "grow": 1.5,
                      "shrink": 1,
                      "basis": "0"
                    }
                  }
                ]
              },
              {
                "type": "ia.display.flex-repeater",
                "meta": {
                  "name": "SummaryRows"
                },
                "props": {
                  "path": "Press1/Parts/AlarmRow",
                  "direction": "column",
                  "wrap": "nowrap",
                  "instances": [],
                  "useDefaultViewWidth": false,
                  "useDefaultViewHeight": false,
                  "elementPosition": {
                    "grow": 0,
                    "shrink": 0,
                    "basis": "31px"
                  },
                  "style": {}
                },
                "position": {
                  "shrink": 0
                },
                "propConfig": {
                  "props.instances": {
                    "binding": {
                      "type": "expr",
                      "config": {
                        "expression": "now(2000)"
                      },
                      "transforms": [
                        {
                          "type": "script",
                          "code": "\treturn press1.cells(press1.alarm_summary(), ['code', 'alarm', 'count', 'total'], '')"
                        }
                      ]
                    }
                  }
                }
              }
            ]
