              {
                "type": "ia.display.flex-repeater",
                "meta": {
                  "name": "EventsRows"
                },
                "props": {
                  "path": "Press1/Parts/EventRow",
                  "direction": "column",
                  "wrap": "nowrap",
                  "instances": [],
                  "useDefaultViewWidth": false,
                  "useDefaultViewHeight": false,
                  "elementPosition": {
                    "grow": 0,
                    "shrink": 0,
                    "basis": "31px"
                  },
                  "style": {
                    "overflowY": "auto"
                  }
                },
                "position": {
                  "shrink": 0,
                  "basis": "300px"
                },
                "propConfig": {
                  "props.instances": {
                    "binding": {
                      "type": "expr",
                      "config": {
                        "expression": "now(2000)"
                      },
                      "transforms": [
                        {
                          "type": "script",
                          "code": "\treturn press1.cells(press1.events(), ['start', 'type', 'detail', 'job', 'duration'], 'No events yet. Watching for state changes...')"
                        }
                      ]
                    }
                  }
                }
              }
            ]
          }
        ]
      },
      {
        "type": "ia.display.label",
        "meta": {
          "name": "Footnote"
        },
        "props": {
          "text": "Events are detected from the PLC state and fault-code registers, sampled every 2 seconds, so durations are accurate to about plus or minus 2 seconds. Setup is shown as a plain state here.",
          "style": {
            "classes": "note",
            "whiteSpace": "normal"
          }
        },
        "position": {
          "shrink": 0
        }
      }
    ]
  },
  "propConfig": {
    "custom.live": {
      "binding": {
        "type": "expr",
        "config": {
          "expression": "now(2000)"
        },
        "transforms": [
          {
            "type": "script",
            "code": "\treturn press1.latest()"
          }
        ]
      }
    },
    "params.window": {
      "paramDirection": "input",
      "persistent": true
    },
    "custom.pct": {
      "binding": {
        "type": "expr",
        "config": {
          "expression": "dateExtract(now(2000), \"second\") * 0 + {view.params.window}"
        },
        "transforms": [
          {
            "type": "script",
            "code": "\treturn press1.state_percent(value)"
          }
        ]
      }
    }
  }
}
