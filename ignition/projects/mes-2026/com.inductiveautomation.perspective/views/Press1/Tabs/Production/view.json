            "type": "ia.display.flex-repeater",
            "meta": {
              "name": "JobsRows"
            },
            "props": {
              "path": "Press1/Parts/JobRow",
              "direction": "column",
              "wrap": "nowrap",
              "instances": [],
              "useDefaultViewWidth": false,
              "useDefaultViewHeight": false,
              "elementPosition": {
                "grow": 0,
                "shrink": 0,
                "basis": "31px"
              },
              "style": {}
            },
            "position": {
              "shrink": 0
            },
            "propConfig": {
              "props.instances": {
                "binding": {
                  "type": "expr",
                  "config": {
                    "expression": "now(2000)"
                  },
                  "transforms": [
                    {
                      "type": "script",
                      "code": "\treturn press1.cells(press1.jobs(), ['product', 'lanes', 'first', 'last', 'good', 'reject'], 'Collecting samples...')"
                    }
                  ]
                }
              }
            }
          },
          {
            "type": "ia.display.label",
            "meta": {
              "name": "JobsNote"
            },
            "props": {
              "text": "The first row can be a partial job if the gateway started mid-job. Deltas show a dash when a counter reset (sim restart) falls inside the job.",
              "style": {
                "classes": "tile-sub",
                "whiteSpace": "normal",
                "marginTop": "8px"
              }
            },
            "position": {
              "shrink": 0
            }
          }
